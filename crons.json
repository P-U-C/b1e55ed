{
  "crons": [
    {
      "name": "b1e55ed Brain Cycle",
      "schedule": {"kind": "every", "everyMs": 300000},
      "payload": {
        "kind": "systemEvent",
        "text": "Run b1e55ed brain cycle: `b1e55ed brain --json`"
      },
      "sessionTarget": "main",
      "_note": "Only enable this cron if running in OpenClaw connected mode WITHOUT the b1e55ed daemon (b1e55ed start). The daemon already runs the brain every 5 minutes — enabling both causes double-fire. Use this as a standalone heartbeat supplement only."
    },
    {
      "name": "b1e55ed Health Check",
      "schedule": {"kind": "every", "everyMs": 3600000},
      "payload": {
        "kind": "systemEvent",
        "text": "Check b1e55ed health: `b1e55ed health --json`"
      },
      "sessionTarget": "main"
    },
    {
      "name": "b1e55ed Position Monitor",
      "schedule": {"kind": "every", "everyMs": 300000},
      "payload": {
        "kind": "systemEvent",
        "text": "Check positions: `b1e55ed positions --json`"
      },
      "sessionTarget": "main"
    }
  ]
}
