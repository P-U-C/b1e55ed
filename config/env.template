# b1e55ed environment variables
# Copy to ~/.b1e55ed/env and fill in your values
# This file is loaded automatically by the systemd service (EnvironmentFile=)
# Do NOT use 'export' or quotes — plain KEY=value format only

# ── Required ──────────────────────────────────────────────────────────────────
B1E55ED_MASTER_PASSWORD=           # Keystore encryption password. Set before first run.

# ── Data providers (recommended) ─────────────────────────────────────────────
ALLIUM_API_KEY=                    # On-chain wallet flows & token data. Free trial at: allium.so
NANSEN_API_KEY=                    # Smart money flows & whale tracking. Plans at: nansen.ai
COINGLASS_API_KEY=                 # BTC/ETH ETF flow data. Free tier at: coinglass.com/account

# ── AI Consensus (ai-consensus producer) ─────────────────────────────────────
# This producer requires a crypto-native AI data source for meaningful signals.
# Generic LLMs are intentionally NOT supported — they lack real-time edge.
ACI_URL=                           # Custom AI consensus endpoint
KAITO_API_KEY=                     # Kaito AI narrative intelligence. Get at: kaito.ai
TOKEN_METRICS_API_KEY=             # Token Metrics AI grades. Get at: tokenmetrics.com

# ── Optional producer overrides ───────────────────────────────────────────────
# Set these to use a custom endpoint instead of the built-in free fallback

B1E55ED_ONCHAIN_FLOWS_URL=         # Custom onchain-flows endpoint (overrides Allium direct)
B1E55ED_SENTIMENT_URL=             # Custom market-sentiment endpoint (overrides F&G free fallback)
B1E55ED_EVENTS_URL=                # Custom market-events endpoint (overrides CryptoPanic free fallback)
B1E55ED_ETF_FLOWS_URL=             # Custom etf-flows endpoint (overrides Coinglass + Yahoo Finance fallback)
B1E55ED_TRADFI_BASIS_URL=          # Custom tradfi-basis endpoint (overrides Binance direct)
B1E55ED_ORDERBOOK_URL=             # Custom orderbook-depth endpoint (overrides Binance free)
B1E55ED_WHALE_TRACKING_URL=        # Custom whale-tracking endpoint (overrides Binance free)
DEERFLOW_GATEWAY_API_KEY=          # DeerFlow research gateway. Contact: deerflow.tech
B1E55ED_CURATOR_FILE=              # Path to local JSON file for curator-intel signals
POST_FIAT_SIGNALS_URL=             # Post Fiat signals endpoint (no default — must set explicitly)

# ── Execution mode ────────────────────────────────────────────────────────────
B1E55ED_EXECUTION__MODE=paper      # paper (simulated) or live (real money). Start with paper.

# ── Exchange credentials (required for live trading only) ─────────────────────
# B1E55ED_HYPERLIQUID_API_KEY=
# B1E55ED_HYPERLIQUID_SECRET=

# ── Advanced overrides ────────────────────────────────────────────────────────
# Override any config value using B1E55ED_<SECTION>__<KEY> format:
# B1E55ED_RISK__MAX_DRAWDOWN_PCT=0.15
# B1E55ED_WEIGHTS__CURATOR=0.30
# B1E55ED_KARMA__ENABLED=true
# B1E55ED_KARMA__PERCENTAGE=0.005
# B1E55ED_KARMA__TREASURY_ADDRESS=0x...

# ── Known issues & producer health notes ──────────────────────────────────────
# These producers may log warnings without their keys — this is NORMAL.
# b1e55ed runs fine without any API keys. Producers silently degrade.
#
# ai-consensus:     Needs ACI_URL, KAITO_API_KEY, or TOKEN_METRICS_API_KEY
#                   Without any source: silently skips (no signals emitted)
#
# curator-intel:    Needs B1E55ED_CURATOR_URL or B1E55ED_CURATOR_FILE
#                   Without: logs "curator_source_missing" each cycle (harmless)
#
# polymarket:       Uses public CLOB API (no key needed)
#                   May log "polymarket_clob_unavailable" if their API is down
#                   This is external — not a config problem
#
# market-events:    Uses CryptoPanic free fallback
#                   Occasionally quarantined if upstream APIs flake
#                   Restart via dashboard if stuck
#
# post-fiat-signals: Needs POST_FIAT_SIGNALS_URL
#                    Without: silently skips
#
# onchain-flows:    Needs ALLIUM_API_KEY
#                   Without: silently skips
#
# etf-flows:        Needs COINGLASS_API_KEY
#                   Without: uses Yahoo Finance fallback (limited)

# ── Kill switch (paper trading) ───────────────────────────────────────────────
# BUG: The brain's crisis-regime kill switch always triggers when regime=CRISIS
# because the orchestrator passes the threshold value as the condition count.
# Workaround: set l3_crisis_threshold: 999 in user.yaml for paper trading.
# If kill switch gets stuck at L3, reset with: b1e55ed kill-switch set 0
